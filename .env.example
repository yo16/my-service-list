# ローカルの登録画面（node scripts/admin.mjs）が読む設定。
# このファイルを .env という名前でコピーして値を入れる。.env は .gitignore に入っていてコミットされない。

# Supabase の Connect ダイアログに出る URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase の Settings → API Keys にある secret key（sb_secret_ で始まる）
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# 任意。非公開リポジトリも候補に出したいときの GitHub fine-grained PAT。
# 書かなければ gh CLI のログインを使い、それもなければ公開リポジトリだけを候補に出す。
# GH_READ_TOKEN=github_pat_xxxxxxxx
